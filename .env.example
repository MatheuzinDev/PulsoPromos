# Copie para .env e preencha com valores reais. Nunca versione o .env (RNF01).

# Postgres (usado pelo docker-compose e pela API)
POSTGRES_USER=pulso
POSTGRES_PASSWORD=
POSTGRES_DB=pulso

# String de conexao usada pela API (SQLAlchemy, driver psycopg v3)
DATABASE_URL=postgresql+psycopg://pulso:pulso@localhost:5432/pulso

# development | staging | production
ENVIRONMENT=development
